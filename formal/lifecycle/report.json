  "requirements": [
    {
      "id": "R1",
      "label": "legal_hold / private / secret / sensitive は自動 archive・purge の候補にしない",
      "source_ids": [
        "SPEC",
        "POLICY"
      ],
      "check_ids": [
        "C1"
      ]
    },
    {
      "id": "R2",
      "label": "hard purge は archive 済みの行だけを対象にする",
      "source_ids": [
        "SPEC",
        "CORE"
      ],
      "check_ids": [],
      "unmodeled_reason": "選択関数が未 archive の行を拒否する。模型では archive 済みだけが削除の候補になる前提にした。"
    },
    {
      "id": "R3",
      "label": "hard purge は restore できる backup を要求する",
      "source_ids": [
        "SPEC",
        "CORE"
      ],
      "check_ids": [],
      "unmodeled_reason": "模型では backup を取るまで計画を作れない形にした。backup の中身と archive の対応は模型の外。"
    },
    {
      "id": "R4",
      "label": "実行は計画の hash と期限に一致する必要がある",
      "source_ids": [
        "CORE"
      ],
      "check_ids": [
        "C1"
      ]
    },
    {
      "id": "R5",
      "label": "archive の実行と同じ要求で hard purge や compact を走らせない",
      "source_ids": [
        "SPEC"
      ],
      "check_ids": [],
      "unmodeled_reason": "API の分離で担保する性質で、今回の模型は削除の 2 段階だけを扱う。"
    },
    {
      "id": "R6",
      "label": "期限切れの計画は実行しない",
      "source_ids": [
        "CORE"
      ],
      "check_ids": [],
      "unmodeled_reason": "Execute の前提 now < expiry に埋め込んだ。反例の探索対象にはしていない。"
    },
    {
      "id": "R7",
      "label": "自動実行は監査記録を残す",
      "source_ids": [
        "SPEC"
      ],
      "check_ids": [],
      "unmodeled_reason": "記録の有無は実行経路の観測で確かめる性質で、模型の外。"
    },
    {
      "id": "R8",
      "label": "durable 型（decision / pattern / preference / lesson）は既定 TTL を付けない",
      "source_ids": [
        "SPEC",
        "POLICY"
      ],
      "check_ids": [],
      "unmodeled_reason": "候補選択の判定で、今回の削除 2 段階の模型とは別の性質。"
    }
  ],
